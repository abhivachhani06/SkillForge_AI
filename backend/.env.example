# SkillForge AI Backend Environment Configuration Template
# Copy this file to .env and fill in the values

# Supabase Project Connection Details
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL Database URL (from Supabase Database Settings)
# Make sure to URL-encode special characters in the password (e.g. # -> %23)
DATABASE_URL=postgresql://postgres:password@db.your-supabase-project.supabase.co:5432/postgres
